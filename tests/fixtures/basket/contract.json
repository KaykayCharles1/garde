    "creation_status": "success",
    "source_code": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.24;\n\nimport {ERC20, Ownable} from \"./lib/Base.sol\";\n\n/// @title BASK \u2014 the BASKET Protocol token.\n/// @notice Fixed 100M supply minted at genesis to the distributor\n/// (treasury + emissions schedule handled off this contract). Utility:\n/// governance voting, staking for fee share (BASKStaking), launch\n/// priority and fee discounts read from staked balances.\ncontract BASK is ERC20, Ownable {\n    uint256 public constant MAX_SUPPLY = 100_000_000e18;\n\n    /// @notice Contract-level metadata (image, website, socials), following\n    /// the convention read by explorers, bots and launch tooling on\n    /// Robinhood Chain. Set once at deployment; NO setter exists \u2014 this is\n    /// a read-only string, not a control surface.\n    string public tokenURI;\n\n    constructor(address distributor, string memory _tokenURI) ERC20(\"BASKET Protocol\", \"BASK\") {\n        tokenURI = _tokenURI;\n        _mint(distributor, MAX_SUPPLY);\n    }\n}\n",
